rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // CORE HELPERS
    // =====================================================
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isFriend(uid) {
      return signedIn()
        && userExists(uid)
        && request.auth.uid in userDoc(uid).data.get("friends", [])
        && uid in userDoc(request.auth.uid).data.get("friends", []);
    }

    function userBlocked(uid) {
      return signedIn()
        && userExists(uid)
        && request.auth.uid in userDoc(uid).data.get("blockedUsers", []);
    }

    function chatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in
           get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function validDirectParticipants(p) {
      return p is list
        && p.size() == 2
        && request.auth.uid in p;
    }

    function directOtherUser(p) {
      return p[0] == request.auth.uid ? p[1] : p[0];
    }

    // =====================================================
    // USERS
    // =====================================================
    match /users/{userId} {
      // People search/profile loading needs authenticated reads.
      allow get, list: if signedIn();

      allow create: if isUser(userId);

      // Normal self-profile update.
      allow update: if isUser(userId);

      // During friend acceptance, the recipient also needs to add
      // themselves to the sender's friends array. Only that narrow
      // friends/updatedAt change is permitted.
      allow update: if signedIn()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["friends", "updatedAt"])
        && request.resource.data.friends is list
        && request.auth.uid in request.resource.data.friends
        && exists(/databases/$(database)/documents/friendRequests/$(userId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/friendRequests/$(userId + "_" + request.auth.uid)).data.status == "accepted";

      allow delete: if isUser(userId);
    }

    // =====================================================
    // FRIEND REQUESTS
    // =====================================================
    match /friendRequests/{requestId} {
      // Both sides may read their own request documents.
      allow get: if signedIn()
        && (resource.data.fromId == request.auth.uid
            || resource.data.toId == request.auth.uid);

      // Supports queries filtered by fromId/toId. The query itself must
      // only return requests belonging to the signed-in user.
      allow list: if signedIn()
        && (resource.data.fromId == request.auth.uid
            || resource.data.toId == request.auth.uid);

      // Sender creates a new pending request to another user.
      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && userExists(request.resource.data.toId)
        && request.resource.data.status == "pending"
        && request.resource.data.fromId is string
        && !isFriend(request.resource.data.toId)
        && !userBlocked(request.resource.data.toId);

      // Recipient can accept/decline. Sender can cancel.
      // No one may change fromId/toId after creation.
      allow update: if signedIn()
        && request.resource.data.fromId == resource.data.fromId
        && request.resource.data.toId == resource.data.toId
        && (
          // Sender cancels a pending request.
          (
            resource.data.fromId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "cancelled"
          )
          ||
          // Recipient accepts a pending request.
          (
            resource.data.toId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "accepted"
          )
          ||
          // Recipient declines a pending request.
          (
            resource.data.toId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "declined"
          )
        );

      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid
            || resource.data.toId == request.auth.uid);
    }

    // =====================================================
    // DIRECT + GROUP CHATS
    // =====================================================
    match /chats/{chatId} {
      allow get, list: if chatMember(chatId);

      // Direct chat: only mutual friends can create a chat.
      // Group chat: signed-in user must be included in participants.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants
        && (
          (
            request.resource.data.type == "direct"
            && validDirectParticipants(request.resource.data.participants)
            && directOtherUser(request.resource.data.participants) != request.auth.uid
            && isFriend(directOtherUser(request.resource.data.participants))
            && !userBlocked(directOtherUser(request.resource.data.participants))
          )
          ||
          request.resource.data.type == "group"
        );

      // Participants cannot be replaced by arbitrary users.
      allow update: if chatMember(chatId)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);

        // Only an actual chat member can send, and senderId must be them.
        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid;

        allow update: if chatMember(chatId)
          && request.resource.data.senderId == resource.data.senderId;

        allow delete: if chatMember(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // =====================================================
    // GROUP INDEX
    // =====================================================
    match /groupIndex/{groupId} {
      allow get, list: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;

      allow update: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    // =====================================================
    // REPORTS
    // =====================================================
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string;

      allow get: if signedIn()
        && resource.data.reporterId == request.auth.uid;

      allow list: if false;

      allow update, delete: if signedIn()
        && resource.data.reporterId == request.auth.uid;
    }

    // =====================================================
    // VOICE / VIDEO CALL SIGNALING
    // =====================================================
    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.callerId != request.resource.data.calleeId
        && request.resource.data.status == "ringing"
        && request.resource.data.type in ["voice", "video"]
        && isFriend(request.resource.data.calleeId)
        && !userBlocked(request.resource.data.calleeId);

      allow get: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      // Incoming-call listener filtered by calleeId.
      allow list: if signedIn()
        && resource.data.calleeId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        )
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.type == resource.data.type;

      allow delete: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      match /{candidateCollection}/{candidateId} {
        allow read, create: if signedIn()
          && exists(/databases/$(database)/documents/calls/$(callId))
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
          );
      }
    }

    // =====================================================
    // DEFAULT DENY
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
