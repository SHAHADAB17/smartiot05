rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isParticipant(chatId) {
      return signedIn() && request.auth.uid in chatData(chatId).participants;
    }

    function acceptedFriendBetween(a, b) {
      return signedIn() && (
        get(/databases/$(database)/documents/friendRequests/$(a)_$(b)).data.status == 'accepted' ||
        get(/databases/$(database)/documents/friendRequests/$(b)_$(a)).data.status == 'accepted'
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId);

      // Own profile updates remain allowed. A second user may only update
      // the target's friends field after a real accepted friend request.
      allow update: if isUser(userId)
        || (signedIn()
          && acceptedFriendBetween(request.auth.uid, userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends','updatedAt'])
          && request.resource.data.friends.hasAll(resource.data.friends)
          && request.auth.uid in request.resource.data.friends);

      allow delete: if isUser(userId);
    }

    // Friend requests
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fromId is string
        && request.resource.data.createdAt != null;

      allow update: if signedIn()
        && resource.data.fromId is string
        && resource.data.toId is string
        && (
          (request.auth.uid == resource.data.toId
            && request.resource.data.status in ['accepted','declined'])
          ||
          (request.auth.uid == resource.data.fromId
            && request.resource.data.status == 'cancelled')
        )
        && request.resource.data.fromId == resource.data.fromId
        && request.resource.data.toId == resource.data.toId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    // Direct and group chats
    match /chats/{chatId} {
      allow read: if isParticipant(chatId);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(chatId)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isParticipant(chatId)
          && (request.resource.data.senderId == resource.data.senderId
            || request.resource.data.seen == true
            || request.resource.data.delivered == true);
        allow delete: if isParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Group index
    match /groupIndex/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }
  }
}
